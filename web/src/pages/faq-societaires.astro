---
import { fr } from '@/i18n/fr';
import Base from '@/layouts/Base.astro';

const t = fr.faq;
const questions = [{ question: t.question, answer: t.answer }, ...t.questions];
---

<Base title={t.title} description={t.description}>
  <div class="faq-page">
    <h1>{t.title}</h1>
    <div class="faq-questions">
      {questions.map(({ question, answer }) => (
        <details>
          <summary><h2>{question}</h2></summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</Base>

<style>
  .faq-page {
    max-width: var(--reading-width);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  h1 {
    color: var(--accent);
    font-size: var(--text-2xl);
    line-height: var(--leading-title);
    font-weight: 700;
  }

  .faq-questions {
    border-top: var(--story-border) solid var(--line);
  }

  details {
    border-bottom: var(--story-border) solid var(--line);
  }

  summary {
    min-height: var(--action-height);
    padding-block: var(--space-4);
    padding-inline: var(--space-2);
    color: var(--accent);
    cursor: pointer;
  }

  summary h2 {
    display: inline;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  summary:hover {
    background: var(--surface-raised);
    color: var(--accent-strong);
  }

  summary:focus-visible {
    outline-offset: var(--space-1);
  }

  details > p {
    padding-inline: var(--space-2);
    padding-bottom: var(--space-6);
    line-height: var(--leading-body);
  }

  a {
    color: var(--accent);
    text-underline-offset: var(--space-1);
  }

  a:hover {
    color: var(--accent-strong);
  }
</style>
