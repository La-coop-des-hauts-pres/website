<bee-swarm aria-hidden="true">
  <template>
    <svg class="swarm-bee" viewBox="0 0 50 36" fill="none" focusable="false" aria-hidden="true">
      <g stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path class="nature-bee-wings" d="M17 15C4 9 9 1 16 5c5 2 6 6 8 9M26 13C24 3 31 0 34 6c2 4-1 7-4 9" />
        <path class="nature-bee-body" d="M10 21c1-6 8-9 16-8 9 1 14 6 12 11-2 6-10 8-18 6-7-1-11-5-10-9Z" />
        <path d="M18 14c-1 5-1 10 1 16m7-17c-1 6 0 12 2 17M38 22l6-2M9 20l-4-4M10 18l-2-6" />
      </g>
    </svg>
  </template>
</bee-swarm>

<script>
  type Bee = { element: SVGElement; x: number; y: number; vx: number; vy: number };
  class BeeSwarm extends HTMLElement {
    private events?: AbortController;
    private frame = 0;
    private bees: Bee[] = [];
    private previous = 0;
    private lastScroll = 0;
    private pointer = { x: -1000, y: -1000 };

    connectedCallback() {
      this.events?.abort();
      this.events = new AbortController();
      const { signal } = this.events;
      const motion = window.matchMedia('(prefers-reduced-motion: no-preference)');
      const template = this.querySelector('template');
      if (!template) return;
      const moving = () => motion.matches && document.documentElement.dataset.motionPaused !== 'true' && !document.hidden;
      const place = (bee: Bee) => {
        bee.element.style.transform = `translate3d(${bee.x}px, ${bee.y}px, 0) rotate(${bee.vx < 0 ? -12 : 12}deg)`;
      };
      const resize = () => {
        const count = Math.max(3, Math.min(12, Math.floor(window.innerWidth * window.innerHeight / 260000) + 2));
        while (this.bees.length < count) {
          const element = template.content.firstElementChild?.cloneNode(true) as SVGElement | undefined;
          if (!element) break;
          const angle = Math.random() * Math.PI * 2;
          const bee = { element, x: Math.random() * window.innerWidth, y: Math.random() * window.innerHeight, vx: Math.cos(angle) * 20, vy: Math.sin(angle) * 20 };
          this.bees.push(bee);
          this.append(element);
          place(bee);
        }
        while (this.bees.length > count) this.bees.pop()?.element.remove();
        for (const bee of this.bees) {
          bee.x = Math.max(0, Math.min(window.innerWidth - 24, bee.x));
          bee.y = Math.max(0, Math.min(window.innerHeight - 20, bee.y));
          place(bee);
        }
      };
      const wrap = (value: number, size: number) => ((value + 30) % (size + 60) + size + 60) % (size + 60) - 30;
      const tick = (time: number) => {
        if (!moving()) { this.frame = 0; return; }
        if (this.previous && time - this.previous < 33) { this.frame = requestAnimationFrame(tick); return; }
        const delta = this.previous ? Math.min((time - this.previous) / 1000, 0.06) : 0;
        this.previous = time;
        for (const bee of this.bees) {
          const dx = bee.x + 12 - this.pointer.x;
          const dy = bee.y + 9 - this.pointer.y;
          const distance = Math.hypot(dx, dy);
          if (distance > 1 && distance < 150) {
            const push = (1 - distance / 150) * 700 * delta;
            bee.vx += dx / distance * push;
            bee.vy += dy / distance * push;
          }
          const speed = Math.hypot(bee.vx, bee.vy);
          if (speed > 140) { bee.vx *= 140 / speed; bee.vy *= 140 / speed; }
          else if (speed > 20) {
            const damping = Math.max(20 / speed, Math.exp(-0.9 * delta));
            bee.vx *= damping;
            bee.vy *= damping;
          }
          bee.x = wrap(bee.x + bee.vx * delta, window.innerWidth);
          bee.y = wrap(bee.y + bee.vy * delta, window.innerHeight);
          place(bee);
        }
        this.frame = requestAnimationFrame(tick);
      };
      const sync = () => {
        cancelAnimationFrame(this.frame);
        this.frame = 0;
        this.previous = 0;
        this.lastScroll = window.scrollY;
        if (moving()) this.frame = requestAnimationFrame(tick);
      };
      resize();
      sync();
      window.addEventListener('resize', resize, { passive: true, signal });
      window.addEventListener('pointermove', (event) => { this.pointer = { x: event.clientX, y: event.clientY }; }, { passive: true, signal });
      document.documentElement.addEventListener('pointerleave', () => { this.pointer = { x: -1000, y: -1000 }; }, { signal });
      window.addEventListener('scroll', () => {
        const offset = window.scrollY - this.lastScroll;
        this.lastScroll = window.scrollY;
        if (!moving()) return;
        for (const bee of this.bees) bee.y = wrap(bee.y - offset, window.innerHeight);
      }, { passive: true, signal });
      window.addEventListener('hautspres-motion-change', sync, { signal });
      document.addEventListener('visibilitychange', sync, { signal });
      motion.addEventListener('change', sync, { signal });
    }
    disconnectedCallback() {
      this.events?.abort();
      cancelAnimationFrame(this.frame);
      for (const bee of this.bees) bee.element.remove();
      this.bees = [];
    }
  }
  if (!customElements.get('bee-swarm')) customElements.define('bee-swarm', BeeSwarm);
</script>
